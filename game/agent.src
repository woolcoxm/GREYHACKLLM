// GreyLLM agent — in-game harness runtime for Grey Hack (singleplayer)
//
// This is the "hands" of the AI. The daemon (daemon/bridge.py) on your PC
// runs the model; when the model wants to inspect or change your in-game
// machine, the daemon stages a tool command on the bridge and THIS program
// executes it: listing folders, reading/writing/deleting files, compiling
// source into binaries, launching programs.
//
// Usage (from any in-game terminal):
//   agent            interactive harness chat (recommended) — every message
//                     continues the same mission; his plan/notes survive
//   agent <task...>  one-shot mission; the final answer prints here
//   /new             from any terminal, even mid-mission elsewhere:
//                     cancels the active mission and clears ALL context
//                     (history, plan, notes) for a fresh engagement
//   agent -t         bridge self-test (creates the bridge files, PINGs the
//                     daemon; works even without an API key)
//   agent -w         re-attach to the current task's tool loop
//   agent -r         print the last reply again
//   agent -s <name>  save the last reply's code block to ~/<name>
//
// How a round works:
//   1. a request (your message) is written to the bridge with a fresh nonce
//   2. serve() polls the bridge ~once a second and:
//        - prints "[thought] ..." lines as the daemon publishes the
//          model's interim thinking (so long LLM rounds don't look frozen)
//        - executes each tool command and prints "[agent] tool: <op>"
//   3. when the daemon writes the completion marker for OUR nonce, the
//      reply prints and control returns to the prompt
//   Strict nonce matching everywhere: stale markers from older missions
//   never satisfy a wait; the daemon verifies+retries its own writes.
//
// Bridge files live in /home/<you>/.greyllm/ on this machine:
//   game-owned:  prompt.txt mode.txt status.txt ("busy <nonce>")
//                command_status.txt ("done/error <tag>") command_result.txt
//   daemon-owned: response.txt done.txt ("done <nonce>") command.txt
//                payload.txt cmdflag.txt ("pending <nonce>")
//   shared:      thinking.txt (live thoughts) cancel.txt (/new aborts)
//   the agent's: plan.txt notes.txt out.txt counter.txt
//
// Tool programs the model writes append their results to out.txt, which
// run_program collects after launch. Launched programs run synchronously —
// a long tool blocks this terminal until it exits.
//
// AGENT_VERSION is checked by the daemon at startup (and after each
// mission): an outdated /bin/agent is re-installed automatically from the
// repo's game/agent.src through the hook — no manual re-pasting.

BRIDGE_DIR = home_dir + "/.greyllm"
AGENT_VERSION = "11"
STALL_TIMEOUT = 900
MARKER = "GreyLLM-BRIDGE-READY"
NL = char(10)

usage = function()
	print("GreyLLM agent - in-game AI harness")
	print("usage: agent            interactive chat (recommended)")
	print("       agent <task...>  one-shot mission")
	print("       /new             clear context, start a fresh engagement")
	print("       agent -t   test bridge")
	print("       agent -w   keep watching current task")
	print("       agent -r   show last answer")
	print("       agent -s <name>   save last code block")
end function

getComp = function()
	return get_shell.host_computer
end function

getOrCreateFolder = function(comp, path)
	folder = comp.File(path)
	if folder != null then
		return folder
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	result = comp.create_folder(parent_path(path), name)
	folder = comp.File(path)
	if folder == null then
		print("ERROR: could not create " + path + " (" + result + ")")
	end if
	return folder
end function

getOrCreateFile = function(comp, path)
	f = comp.File(path)
	if f != null then
		return f
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	result = comp.touch(parent_path(path), name)
	f = comp.File(path)
	if f == null then
		print("ERROR: could not create " + path + " (" + result + ")")
	end if
	return f
end function

reply = function(comp, ok, text, tag)
	// the tag makes each round's completion unique — a stale "done" from a
	// previous tool round must never satisfy the daemon's next wait
	resultF = comp.File(BRIDGE_DIR + "/command_result.txt")
	statusF = comp.File(BRIDGE_DIR + "/command_status.txt")
	if resultF == null then
		return null
	end if
	if statusF == null then
		return null
	end if
	resultF.set_content(text)
	if tag == null then
		tag = "0"
	end if
	if ok then
		statusF.set_content("done " + tag)
	else
		statusF.set_content("error " + tag)
	end if
	return null
end function

execute = function(comp, cmd)
	// NOTE: split() is regex-based in GreyScript — ";" has no regex meaning.
	// Format: op;arg1;arg2;tag — the tag is always the last field.
	parts = cmd.split(";")
	op = parts[0]
	tag = parts[parts.len - 1]

	if op == "list" then
		if parts.len < 2 then
			reply(comp, false, "list needs a path", tag)
			return null
		end if
		folder = comp.File(parts[1])
		if folder == null then
			reply(comp, false, "not found: " + parts[1], tag)
			return null
		end if
		rows = ""
		files = folder.get_files
		if files != null then
			for f in files
				rows = rows + "FILE " + f.path + NL
			end for
		end if
		folders = folder.get_folders
		if folders != null then
			for f in folders
				rows = rows + "DIR " + f.path + NL
			end for
		end if
		reply(comp, true, rows, tag)
		return null
	end if

	if op == "read" then
		if parts.len < 2 then
			reply(comp, false, "read needs a path", tag)
			return null
		end if
		f = comp.File(parts[1])
		if f == null then
			reply(comp, false, "not found: " + parts[1], tag)
			return null
		end if
		reply(comp, true, f.get_content, tag)
		return null
	end if

	if op == "write" then
		if parts.len < 2 then
			reply(comp, false, "write needs a path", tag)
			return null
		end if
		payloadF = comp.File(BRIDGE_DIR + "/payload.txt")
		content = ""
		if payloadF != null then
			content = payloadF.get_content
		end if
		f = getOrCreateFile(comp, parts[1])
		if f == null then
			reply(comp, false, "cannot create " + parts[1], tag)
			return null
		end if
		f.set_content(content)
		reply(comp, true, "wrote " + content.len + " chars to " + parts[1], tag)
		return null
	end if

	if op == "append" then
		if parts.len < 2 then
			reply(comp, false, "append needs a path", tag)
			return null
		end if
		payloadF = comp.File(BRIDGE_DIR + "/payload.txt")
		content = ""
		if payloadF != null then
			content = payloadF.get_content
		end if
		f = getOrCreateFile(comp, parts[1])
		if f == null then
			reply(comp, false, "cannot create " + parts[1], tag)
			return null
		end if
		f.set_content(f.get_content + content)
		reply(comp, true, "appended " + content.len + " chars to " + parts[1], tag)
		return null
	end if

	if op == "mkdir" then
		if parts.len < 2 then
			reply(comp, false, "mkdir needs a path", tag)
			return null
		end if
		folder = getOrCreateFolder(comp, parts[1])
		if folder == null then
			reply(comp, false, "cannot create " + parts[1], tag)
			return null
		end if
		reply(comp, true, parts[1], tag)
		return null
	end if

	if op == "rm" then
		if parts.len < 2 then
			reply(comp, false, "rm needs a path", tag)
			return null
		end if
		f = comp.File(parts[1])
		if f == null then
			reply(comp, false, "not found: " + parts[1], tag)
			return null
		end if
		f.delete
		reply(comp, true, "deleted " + parts[1])
		return null
	end if

	if op == "run" then
		if parts.len < 2 then
			reply(comp, false, "run needs a path", tag)
			return null
		end if
		args = ""
		if parts.len >= 3 then
			args = parts[2]
		end if
		outF = getOrCreateFile(comp, BRIDGE_DIR + "/out.txt")
		if outF != null then
			outF.set_content(" ")
		end if
		launchResult = get_shell.launch(parts[1], args)
		out = ""
		if launchResult == 1 then
			// poll out.txt: launched programs write results asynchronously,
			// so give them up to ~10s and return once output stops changing
			lastOut = null
			stable = 0
			for i in range(0, 9)
				wait(1)
				outFile2 = comp.File(BRIDGE_DIR + "/out.txt")
				if outFile2 != null then
					out = outFile2.get_content
				end if
				if out == lastOut then
					stable = stable + 1
				else
					stable = 0
				end if
				lastOut = out
				if stable >= 2 then
					break
				end if
			end for
		end if
		reply(comp, true, "launch returned: " + launchResult + NL + "out.txt follows:" + NL + out, tag)
		return null
	end if

	if op == "build" then
		if parts.len < 3 then
			reply(comp, false, "build needs source path and destination folder", tag)
			return null
		end if
		// the game's build wants a destination FOLDER; if the model passed
		// a file path, fall back to its parent folder
		destFolder = parts[2]
		if comp.File(destFolder) == null then
			destFolder = parent_path(destFolder)
		end if
		buildResult = get_shell.build(parts[1], destFolder)
		reply(comp, true, "build returned: " + buildResult, tag)
		return null
	end if

	if op == "sysinfo" then
		rows = "home: " + home_dir + NL
		rows = rows + "bridge: " + BRIDGE_DIR + NL
		bin = comp.File("/bin")
		if bin != null then
			binFiles = bin.get_files
			if binFiles != null then
				for f in binFiles
					rows = rows + "/bin/" + f.name + NL
				end for
			end if
		end if
		lib = comp.File("/lib")
		if lib != null then
			libFiles = lib.get_files
			if libFiles != null then
				for f in libFiles
					rows = rows + "/lib/" + f.name + NL
				end for
			end if
		end if
		// home disk usage — the machine has LIMITED hard drive space; the
		// agent must see its own footprint and keep it small
		homeF = comp.File(home_dir)
		if homeF != null then
			homeFiles = homeF.get_files
			if homeFiles != null then
				total = 0
				listing = ""
				for f in homeFiles
					sz = f.size
					if sz == null then
						sz = 0
					end if
					total = total + sz
					listing = listing + "  " + f.name + " (" + sz + "b)" + NL
				end for
				rows = rows + "home files: " + str(homeFiles.len) + " (" + total + " bytes total — KEEP THIS SMALL)" + NL
				rows = rows + listing
				if homeFiles.len > 10 then
					rows = rows + "WARNING: too many files in home — delete finished tools (source AND binary) before building more" + NL
				end if
			end if
		end if
		reply(comp, true, rows, tag)
		return null
	end if

	reply(comp, false, "unknown op: " + op, tag)
	return null
end function

serve = function(comp)
	statusF = comp.File(BRIDGE_DIR + "/status.txt")
	cmdStatusF = comp.File(BRIDGE_DIR + "/command_status.txt")
	commandF = comp.File(BRIDGE_DIR + "/command.txt")
	responseF = comp.File(BRIDGE_DIR + "/response.txt")
	if statusF == null then
		print("ERROR: bridge files missing, run agent -t first")
		return null
	end if
	if cmdStatusF == null then
		print("ERROR: bridge files missing, run agent -t first")
		return null
	end if
	if commandF == null then
		print("ERROR: bridge files missing, run agent -t first")
		return null
	end if
	if responseF == null then
		print("ERROR: bridge files missing, run agent -t first")
		return null
	end if
	stalled = 0
	doneTarget = "done " + globals.nonce
	cmdTarget = "pending " + globals.nonce
	// thinking stream: the daemon publishes the model's interim thoughts to
	// thinking.txt; print new content live so long LLM rounds don't look
	// like a frozen terminal. Seed lastThink with the current content so a
	// previous mission's leftover line never reprints.
	lastThink = null
	thinkF0 = comp.File(BRIDGE_DIR + "/thinking.txt")
	if thinkF0 != null then
		lastThink = thinkF0.get_content
	end if
	while stalled < STALL_TIMEOUT
		// re-fetch every poll; done.txt/cmdflag.txt are written in place
		// by the daemon and matched by this task's nonce (strict match —
		// stale foreign values must never satisfy the wait; the daemon
		// verifies and retries its writes to heal tree-flush races).
		// every poll is null-guarded: a file node momentarily missing from
		// a raced tree snapshot must pause one tick, never crash the loop
		doneF = comp.File(BRIDGE_DIR + "/done.txt")
		if doneF == null then
			wait(1)
			stalled = stalled + 1
			continue
		end if
		done = doneF.get_content
		if done == doneTarget then
			respF = comp.File(BRIDGE_DIR + "/response.txt")
			if respF != null then
				print(respF.get_content)
			end if
			return "done"
		end if
		cmdflagPoll = comp.File(BRIDGE_DIR + "/cmdflag.txt")
		if cmdflagPoll == null then
			wait(1)
			stalled = stalled + 1
			continue
		end if
		cs = cmdflagPoll.get_content
		if cs == cmdTarget then
			cmdF = comp.File(BRIDGE_DIR + "/command.txt")
			cmd = ""
			if cmdF != null then
				cmd = cmdF.get_content
			end if
			if cmd != "" then
				cmdParts = cmd.split(";")
				print("[agent] tool: " + cmdParts[0] + " " + cmdParts[1])
				execute(comp, cmd)
				// clear the flag with a tag-unique value so this command cannot
				// re-execute (unique content = unique row = no dedup collisions)
				parts = cmd.split(";")
				ranTag = parts[parts.len - 1]
				cmdflagF = comp.File(BRIDGE_DIR + "/cmdflag.txt")
				if cmdflagF != null then
					cmdflagF.set_content("ran " + ranTag)
				end if
				stalled = 0
			end if
		end if
		// live thinking stream: print when the daemon publishes a new line
		thinkF = comp.File(BRIDGE_DIR + "/thinking.txt")
		if thinkF != null then
			th = thinkF.get_content
			if th != null and th != "" and th != lastThink then
				print("[thought] " + th)
				lastThink = th
				stalled = 0
			end if
		end if
		wait(1)
		stalled = stalled + 1
	end while
	return "timeout"
end function

nextNonce = function(comp)
	// rnd() is DETERMINISTIC in Grey Hack (same value every run) — a
	// counter file is the only reliable source of per-request uniqueness
	counterF = getOrCreateFile(comp, BRIDGE_DIR + "/counter.txt")
	n = 1
	if counterF != null then
		v = counterF.get_content
		if v != null then
			if v != "" then
				n = val(v) + 1
			end if
		end if
		counterF.set_content(str(n))
	end if
	return str(n)
end function

initDaemonFiles = function(comp)
	// daemon-owned files need distinct one-time content so each sits on
	// its own row (touched-empty files would all share the "" row)
	pairs = [["response.txt", "r0"], ["done.txt", "d0"], ["command.txt", "c0"], ["payload.txt", "p0"], ["cmdflag.txt", "f0"], ["command_status.txt", "t0"], ["command_result.txt", "u0"], ["thinking.txt", "k0"], ["cancel.txt", "x0"]]
	for pair in pairs
		f = getOrCreateFile(comp, BRIDGE_DIR + "/" + pair[0])
		if f != null then
			if f.get_content == "" then
				f.set_content(pair[1])
			end if
		end if
	end for
	return null
end function

startTask = function(comp, prompt, interactive)
	folder = getOrCreateFolder(comp, BRIDGE_DIR)
	if folder == null then
		return null
	end if
	initDaemonFiles(comp)
	promptF = getOrCreateFile(comp, BRIDGE_DIR + "/prompt.txt")
	modeF = getOrCreateFile(comp, BRIDGE_DIR + "/mode.txt")
	statusF = getOrCreateFile(comp, BRIDGE_DIR + "/status.txt")
	if promptF == null then
		return null
	end if
	if modeF == null then
		return null
	end if
	if statusF == null then
		return null
	end if
	nonce = nextNonce(comp)
	globals.nonce = nonce
	// rewrite every polled file with a fresh nonce BEFORE triggering: this
	// re-aligns the game's in-memory tree, the db tree and the row itself,
	// so the daemon's in-place write lands exactly where we poll
	responseF = getOrCreateFile(comp, BRIDGE_DIR + "/response.txt")
	if responseF == null then
		return null
	end if
	responseF.set_content("r" + nonce)
	doneF = getOrCreateFile(comp, BRIDGE_DIR + "/done.txt")
	if doneF == null then
		return null
	end if
	doneF.set_content("w" + nonce)
	cmdflagF = getOrCreateFile(comp, BRIDGE_DIR + "/cmdflag.txt")
	if cmdflagF != null then
		cmdflagF.set_content("f" + nonce)
	end if
	commandF = getOrCreateFile(comp, BRIDGE_DIR + "/command.txt")
	if commandF != null then
		commandF.set_content("c" + nonce)
	end if
	payloadF = getOrCreateFile(comp, BRIDGE_DIR + "/payload.txt")
	if payloadF != null then
		payloadF.set_content("p" + nonce)
	end if
	promptF.set_content(prompt)
	modeF.set_content("agent")
	statusF.set_content("busy " + nonce)
	// /new from ANY terminal (even while another mission is running in a
	// different terminal): raise the cancel flag so the daemon aborts the
	// active mission, and blank the mission files so nothing survives
	pl = prompt.trim.lower
	if pl == "/new" or pl == "/reset" or pl == "/clear" then
		cancelF = getOrCreateFile(comp, BRIDGE_DIR + "/cancel.txt")
		if cancelF != null then
			cancelF.set_content("cancel " + nonce)
		end if
		planF = comp.File(BRIDGE_DIR + "/plan.txt")
		if planF != null then
			planF.set_content(" ")
		end if
		notesF = comp.File(BRIDGE_DIR + "/notes.txt")
		if notesF != null then
			notesF.set_content(" ")
		end if
	end if
	if interactive != true then
		print("[agent] task sent: " + prompt)
		print("[agent] serving tools now; leave this terminal open")
	end if
	return null
end function

chat = function(comp)
	// interactive harness session: each message continues the same
	// conversation (the daemon keeps history + plan/notes on disk)
	print("[agent] interactive session. full tool access; I keep")
	print("[agent] plan.txt/notes.txt across messages.")
	print("[agent] /new = fresh engagement (from ANY terminal — if")
	print("[agent] this one is busy mid-mission, run agent /new in another)")
	print("[agent] 'exit' to quit.")
	while true
		line = user_input("you> ")
		if line == null then
			break
		end if
		line = line.trim
		if line == "" then
			continue
		end if
		if line == "exit" or line == "quit" or line == "/exit" then
			break
		end if
		startTask(comp, line, true)
		r = serve(comp)
		if r == "timeout" then
			print("[agent] no reply (daemon down or slow). run: agent -w to keep waiting")
		end if
	end while
	print("[agent] session closed")
	return null
end function

runTest = function(comp)
	folder = getOrCreateFolder(comp, BRIDGE_DIR)
	if folder == null then
		return null
	end if
	initDaemonFiles(comp)
	markerF = getOrCreateFile(comp, BRIDGE_DIR + "/bridge.txt")
	if markerF != null then
		markerF.set_content(MARKER)
	end if
	modeF = getOrCreateFile(comp, BRIDGE_DIR + "/mode.txt")
	if modeF != null then
		modeF.set_content("chat")
	end if
	print("bridge files live in " + BRIDGE_DIR)
	print("on your PC run: .\bridge.cmd  (the watch daemon)")
	print("testing bridge...")
	promptF = getOrCreateFile(comp, BRIDGE_DIR + "/prompt.txt")
	statusF = getOrCreateFile(comp, BRIDGE_DIR + "/status.txt")
	responseF = getOrCreateFile(comp, BRIDGE_DIR + "/response.txt")
	if promptF == null then
		return null
	end if
	if statusF == null then
		return null
	end if
	if responseF == null then
		return null
	end if
	nonce = nextNonce(comp)
	globals.nonce = nonce
	responseF.set_content("r" + nonce)
	doneF = getOrCreateFile(comp, BRIDGE_DIR + "/done.txt")
	if doneF == null then
		return null
	end if
	doneF.set_content("w" + nonce)
	promptF.set_content("PING")
	statusF.set_content("busy " + nonce)
	doneTarget = "done " + nonce
	waited = 0
	while waited < 60
		done = comp.File(BRIDGE_DIR + "/done.txt").get_content
		if done == doneTarget then
			print(comp.File(BRIDGE_DIR + "/response.txt").get_content)
			return null
		end if
		wait(1)
		waited = waited + 1
	end while
	print("no answer within 60s — is bridge.py running on your PC?")
	return null
end function

showLast = function(comp)
	responseF = comp.File(BRIDGE_DIR + "/response.txt")
	if responseF == null then
		print("no answer yet")
		return null
	end if
	print(responseF.get_content)
	return null
end function

saveLast = function(comp, name)
	responseF = comp.File(BRIDGE_DIR + "/response.txt")
	if responseF == null then
		print("no answer yet")
		return null
	end if
	txt = responseF.get_content
	// save as an extensionless program in home; the terminal searches the
	// current directory first, so it runs by name from ~ (/bin is not
	// writable by regular users)
	path = home_dir + "/" + name
	parts = txt.split("```")
	code = txt
	if parts.len >= 2 then
		code = parts[1]
	end if
	outF = getOrCreateFile(comp, path)
	if outF == null then
		return null
	end if
	outF.set_content(code)
	print("saved: " + path + " (" + code.len + " chars)")
	print("run it with: " + name + "  (from your home folder)")
	return null
end function

main = function(params)
	comp = getComp()
	if params == null then
		return chat(comp)
	end if
	if params.len == 0 then
		return chat(comp)
	end if
	if params.len == 1 and params[0] == "" then
		return chat(comp)
	end if
	first = params[0]
	if first == "-t" then
		return runTest(comp)
	end if
	if first == "-r" then
		return showLast(comp)
	end if
	if first == "-w" then
		if globals.nonce == null then
			statusF = comp.File(BRIDGE_DIR + "/status.txt")
			if statusF != null then
				parts = statusF.get_content.split(" ")
				if parts.len >= 2 then
					globals.nonce = parts[1]
				end if
			end if
		end if
		if globals.nonce == null then
			globals.nonce = "x"
		end if
		return serve(comp)
	end if
	if first == "-s" then
		if params.len < 2 then
			print("usage: agent -s <name>")
			return null
		end if
		return saveLast(comp, params[1])
	end if
	prompt = params.join(" ")
	startTask(comp, prompt, false)
	r = serve(comp)
	if r == "done" then
		print("[agent] done. save the code with: agent -s <name>")
	else
		print("[agent] timed out waiting. run: agent -w")
	end if
	return null
end function

main(params)
