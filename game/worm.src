// worm — aggressive staged harvesting worm (GreyLLM standard)
// WORM_VERSION = "13" (daemon auto-installs/updates this file)
//
// Per host: break in with the standard ~/exploit tool, ESCALATE LOCALLY
// to root (victim-side exploit -L, password-change attempts, root
// reconnect), harvest bank/mail credentials as root when possible,
// discover that network's attack surface, add random public IPs, clean
// every trace, move to the next host. If root is impossible the host is
// still harvested with the durable user and the infection moves on.
//
// usage (from your home machine):
//   worm [ip ...] [flags]      THE EPIDEMIC — infect -> harvest ->
//                              scan -> infect, breadth-first, FOREVER —
//                              no runtime cap, no idle shutdown (per
//                              operator directive: a worm never stops).
//                              -g=N still caps cycles when explicitly
//                              passed (the agent/harness must use it —
//                              an unbounded run blocks the serve loop).
//                              CPU-wear note: sustained load degrades
//                              hardware; 5s pacing between cycles is the
//                              only restraint left. Run on hardware you
//                              can afford to lose.
//     -g=N   cap on infection cycles this run (default 0 = INFINITE)
//     -t=N   hosts per cycle                (default 3, cap 10)
//     -r=N   random public IPs per cycle    (default 2, cap 8)
//     -auto  ALSO install itself into /etc/init.d (autorun: the
//            epidemic resumes automatically at every game login)
//     -o=P   exfil file, appended per host    (default ~/Desktop/bankintel.txt)
//     -s=P   state file                       (default ~/worm.state)
//     -u=U -w=P   durable creds on victims    (default worm / W0rmPass26x — alphanumeric, <=15)
//     -rp=P  password tried for root changes  (default R00tPass26x)
//
// internal mode (launched BY the worm on a victim):
//   worm -scan -o=PATH     print "ip=A port=N" lines for that network
//
// Mechanics (all verified in-game): footholds only via ~/exploit (this
// worm never fires overflow()); victim entry via connect_service with
// the durable user; LOCAL root escalation runs ON the victim (its own
// metaxploit + /lib); cross-machine file moves use text drop+build or
// shell.scp (get_content refuses binary files); every victim ends with
// artifact deletion and a wiped /var/system.log. GreyScript has no
// try/catch: every call below is null/typeof-guarded, loops are
// bounded, and state is saved after EVERY host so any death resumes.

NL = char(10)
LOGPATH = home_dir + "/worm.log"

wlog = function(line)
	// every worm line goes to the terminal AND ~/worm.log — inspect
	// anytime with read_file even when the launching terminal is gone
	print(line)
	lf = globals.comp0.File(LOGPATH)
	if lf == null then
		globals.comp0.touch(home_dir, "worm.log")
		lf = globals.comp0.File(LOGPATH)
	end if
	if lf != null then
		base = lf.get_content
		if base == null then
			base = ""
		end if
		want = base + line + NL
		lf.set_content(want)
		// tree-flush race check: verify, retry once
		back = lf.get_content
		if back == null or back != want then
			lf.set_content(want)
		end if
	end if
	return null
end function

containsStr = function(hay, needle)
	if hay == null then
		return false
	end if
	return hay.indexOf(needle) != null
end function

ensureFolder = function(comp, path)
	f = comp.File(path)
	if f != null then
		return f
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	r = comp.create_folder(parent_path(path), name)
	f = comp.File(path)
	if f == null then
		print("cannot create folder " + path + " (" + r + ")")
	end if
	return f
end function

ensureFile = function(comp, path, initial)
	f = comp.File(path)
	if f != null then
		return f
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	comp.touch(parent_path(path), name)
	f = comp.File(path)
	if f == null then
		return null
	end if
	if initial != null then
		f.set_content(initial)
	end if
	return f
end function

readFileOr = function(comp, path, fallback)
	f = comp.File(path)
	if f == null then
		return fallback
	end if
	c = f.get_content
	if c == null then
		return fallback
	end if
	return c
end function

appendFile = function(comp, path, text)
	f = ensureFile(comp, path, null)
	if f == null then
		print("cannot write " + path)
		return null
	end if
	base = f.get_content
	if base == null then
		base = ""
	end if
	f.set_content(base + text)
	return null
end function

rndByte = function(salt)
	// decorrelated pseudo-random byte: different arithmetic per call so
	// consecutive bytes never share offsets (rnd() alone is deterministic)
	// time() is a FLOAT and there is no integer division — every result
	// must be floored or the address bytes become decimals
	t = floor(time())
	n1 = floor((t * 7919 + salt * 104729) % 251)
	n2 = floor((floor(t / 7) + salt * 31 + 97) % 241)
	n3 = floor(((t % 65536 * salt) + 337) % 239)
	pick = salt % 3
	if pick == 0 then
		r = n1
	else if pick == 1 then
		r = n2
	else
		r = n3
	end if
	r = floor(r + salt % 17)
	r = floor(r % 254)
	if r == null or r < 1 then
		r = salt % 253 + 1
	end if
	return r
end function

rndPublicIp = function(counter)
	a = rndByte(counter)
	b = rndByte(counter * 5 + 11)
	c = rndByte(counter * 13 + 29)
	d = rndByte(counter * 29 + 71)
	// keep clear of private/reserved ranges
	if a == 10 or a == 127 or a == 172 or a == 192 or a < 20 then
		a = a % 100 + 30
	end if
	return a + "." + b + "." + c + "." + d
end function

// ---- state: "F|ip" frontier, "O|ip|user|pass" owned, "D|ip" done ----

stateLoad = function(comp, path)
	frontier = []
	owned = []
	done = []
	raw = readFileOr(comp, path, "")
	if raw == "" then
		return [frontier, owned, done]
	end if
	lines = raw.split(NL)
	for line in lines
		line = line.trim
		if line == "" then
			continue
		end if
		if line.indexOf("F|") == 0 then
			frontier.push(line[2:])
		else if line.indexOf("O|") == 0 then
			parts = line.split("|")
			if parts.len >= 4 then
				owned.push([parts[1], parts[2], parts[3]])
			end if
		else if line.indexOf("D|") == 0 then
			done.push(line[2:])
		end if
	end for
	return [frontier, owned, done]
end function

stateSave = function(comp, path, frontier, owned, done)
	out = ""
	for ip in frontier
		out = out + "F|" + ip + NL
	end for
	for o in owned
		out = out + "O|" + o[0] + "|" + o[1] + "|" + o[2] + NL
	end for
	for ip in done
		out = out + "D|" + ip + NL
	end for
	f = ensureFile(comp, path, null)
	if f != null then
		f.set_content(out)
	end if
	return null
end function

knownIp = function(frontier, owned, done, ip)
	for x in frontier
		if x == ip then
			return true
		end if
	end for
	for o in owned
		if o[0] == ip then
			return true
		end if
	end for
	for x in done
		if x == ip then
			return true
		end if
	end for
	return false
end function

// ---- victim pipeline ----

harvestHomes = function(comp, exfilPath, tag, vic)
	// steal every readable bank/mail file from every user home
	home = vic.File("/home")
	if home == null then
		return 0
	end if
	users = home.get_folders
	if users == null then
		return 0
	end if
	got = 0
	for uf in users
		files = uf.get_files
		if files == null then
			continue
		end if
		for f in files
			nm = f.name.lower
			if containsStr(nm, "bank") or containsStr(nm, "mail") then
				content = f.get_content
				if content == null then
					continue
				end if
				appendFile(comp, exfilPath, "== " + tag + " " + uf.name + "/" + f.name + " ==" + NL + content + NL)
				got = got + 1
			end if
		end for
	end for
	return got
end function

harvestRootExtras = function(comp, exfilPath, tag, vic)
	// root-only loot: the full account table (hashes crack offline)
	pw = vic.File("/etc/passwd")
	if pw != null then
		c = pw.get_content
		if c != null then
			appendFile(comp, exfilPath, "== " + tag + " /etc/passwd ==" + NL + c + NL)
		end if
	end if
	return null
end function

dropText = function(vic, path, content)
	// write a TEXT file on the victim (binary transfer needs scp)
	parts = path.split("/")
	name = parts[parts.len - 1]
	vic.touch(parent_path(path), name)
	f = vic.File(path)
	if f == null then
		return false
	end if
	f.set_content(content)
	return true
end function

cleanDrops = function(vic, vhome, names)
	for nm in names
		f = vic.File(vhome + "/" + nm)
		if f != null then
			f.delete
		end if
	end for
	return null
end function

installAutorun = function(comp)
	// /etc/init.d on the PLAYER's machine is executed at every game
	// login (AutorunServerRpc, verified in game source) — installing
	// ourselves here makes the epidemic resume automatically each
	// session. Best-effort: requires /etc/init.d write access (root).
	initd = comp.File("/etc/init.d")
	if initd == null then
		print("worm: no /etc/init.d folder — autorun install skipped")
		return false
	end if
	bin = comp.File(home_dir + "/worm")
	if bin == null then
		print("worm: compile ~/worm.src first (-auto needs the binary)")
		return false
	end if
	r = bin.copy("/etc/init.d")
	if typeof(r) == "string" then
		print("worm: autorun install failed: " + r + " (need root? try after -L root)")
		return false
	end if
	print("worm: installed into /etc/init.d — epidemic auto-resumes every login")
	return true
end function

clearLog = function(vic)
	lf = vic.File("/var/system.log")
	if lf != null then
		lf.set_content(" ")
	end if
	return null
end function

escalateLocal = function(comp, sh, vhome, user, pass, rootPass)
	// escalate to root FROM INSIDE the victim: build the standard
	// exploit there and fire its LOCAL /lib attacks. Password-change
	// vulns fire with rootPass; footholds convert to durable access.
	// Returns "root" when a root shell login succeeded.
	b = sh.build(vhome + "/exploit.src", vhome)
	if b != "" then
		print("  escalate: victim-side build failed: " + b)
		return "none"
	end if
	metaxLocal = sh.host_computer.File("/lib/metaxploit.so")
	mFlag = ""
	if metaxLocal == null then
		shipped = sh.host_computer.File(vhome + "/metaxploit.so")
		if shipped != null then
			mFlag = " -m=" + vhome + "/metaxploit.so"
		else
			print("  escalate: no metaxploit on victim — cannot escalate")
			return "none"
		end if
	end if
	// the -L run writes its report on the victim
	lr = sh.launch(vhome + "/exploit", "-L -u=" + user + " -w=" + pass + " -g=" + rootPass + mFlag)
	if lr != 1 then
		print("  escalate: local run failed: " + lr)
		return "none"
	end if
	report = readFileOr(sh.host_computer, vhome + "/exploit_out.txt", "")
	if report == null then
		report = ""
	end if
	if containsStr(report, "FOOTHOLD shell") then
		// the tool already created/re-created the durable user from the
		// foothold — check whether that foothold was root and try a root
		// login via the changed password anyway
		print("  escalate: local foothold gained" + "")
	end if
	if containsStr(report, "SUCCESS") == false then
		return "tried"
	end if
	// a password-change fired — root may now accept rootPass
	rootSh = get_shell.connect_service(ipOf(sh), 22, "root", rootPass)
	if typeof(rootSh) == "shell" then
		print("  escalate: ROOT via password change")
		return ["root", rootSh]
	end if
	return "tried"
end function

ipOf = function(sh)
	// best-effort public ip of the machine a shell lives on
	c = sh.host_computer
	if c == null then
		return "0.0.0.0"
	end if
	p = c.public_ip
	if p == null then
		return "0.0.0.0"
	end if
	return p
end function

processVictim = function(comp, ip, exfilPath, user, pass, rootPass, exSrc, wormSrc)
	// returns ["owned", newIps], "done", or "skip"
	mark = "worm: " + ip
	shell = get_shell

	// 0. ensure our standard tool exists (self-heal compile)
	expBin = comp.File(home_dir + "/exploit")
	if expBin == null then
		b = shell.build(home_dir + "/exploit.src", home_dir)
		if b != "" then
			wlog(mark + ": no ~/exploit and build failed: " + b)
			return "skip"
		end if
	end if

	// 1. break in — FULL fire (default). Quiet mode (-q on the tool)
	// only fires no-requirement exploits, and in practice the world's
	// exploitable vulns are requirement-gated: -q starved the worm to
	// zero entries. Stealth comes from the per-host cleanup + log wipe,
	// not from firing fewer shots.
	//
	// REPORT PATH: mirror the tool's findOut EXACTLY — it writes to the
	// bridge out.txt only when the bridge folder exists, otherwise to
	// ~/exploit_out.txt. Reading a fixed path while the tool fell back
	// made the worm discard 10 real footholds as "no entry".
	outPath = home_dir + "/.greyllm/out.txt"
	if comp.File(home_dir + "/.greyllm") == null then
		outPath = home_dir + "/exploit_out.txt"
	end if
	outF = ensureFile(comp, outPath, " ")
	if outF != null then
		outF.set_content(" ")
	end if
	entryFlags = ""
	if globals.quietEntry == true then
		entryFlags = " -q"
	end if
	lr = shell.launch(home_dir + "/exploit", ip + entryFlags + " -u=" + user + " -w=" + pass)
	if lr != 1 then
		wlog(mark + ": exploit launch failed: " + lr)
		return "skip"
	end if
	report = readFileOr(comp, outPath, "")
	if containsStr(report, "FOOTHOLD") == false and containsStr(report, "SUCCESS") == false then
		wlog(mark + ": no entry (requirements unmet or nothing there)")
		return "done"
	end if

	// 2. the exploit tool (v14) harvested, cracked and escalated AT
	//    FOOTHOLD TIME — re-login is obsolete: http-only hosts have no
	//    ssh:22 to return to, create_user is root-only, /etc/passwd is
	//    guest-denied. Read what the foothold already extracted.
	harvestedFiles = 0
	harvestedChars = 0
	for line in report.split(NL)
		h = line.indexOf("HARVEST ")
		if h != null then
			harvestedFiles = harvestedFiles + 1
			op = line.indexOf("(")
			cp2 = line.indexOf(" chars)")
			if op != null and cp2 != null then
				harvestedChars = harvestedChars + val(line[op + 1:cp2])
			end if
		end if
	end for
	if harvestedFiles > 0 then
		wlog(mark + ": OWNED — harvested " + harvestedFiles + " files (" + harvestedChars + " chars) to " + exfilPath)
	end if
	// entries for the state file: hosts we OWNED get kept with the
	// durable creds; ssh-capable hosts can still be re-entered manually
	ownedNow = containsStr(report, "OWNED ")
	vhome = "/tmp/worms"
	drops = []

	// 3-7 (v14): the OLD post-login pipeline (drop/build/escalate/
	// harvest/clean via connect_service shell) is retired — v14's
	// exploit does all of it AT FOOTHOLD TIME. The worm's remaining
	// job per host: count the take, mark state, and move on.
	//
	// Network spread still uses the victim-side scan when a SHELL
	// foothold was available — the exploit tool reports it already
	// dropped+ran worm -scan inside /tmp; its results ride in the
	// report as NEWTARGET lines.
	newIps = []
	for line in report.split(NL)
		nt = line.indexOf("NEWTARGET ")
		if nt != null then
			nip = line[nt + 10:].trim
			if nip != "" then
				newIps.push(nip)
			end if
		end if
	end for
	if ownedNow then
		return ["owned", newIps]
	end if
	wlog(mark + ": foothold without harvest (denied homes or empty boxes)")
	return ["owned", newIps]
end function

// ---- scan mode (runs ON a victim; the parent reads the file back) ----

scanMode = function(comp, outPath)
	r = get_router
	if r == null then
		appendFile(comp, outPath, "scan: no router" + NL)
		return null
	end if
	pub = r.public_ip
	if pub == null then
		appendFile(comp, outPath, "scan: no public ip" + NL)
		return null
	end if
	ports = r.used_ports
	if ports != null then
		for p in ports
			if p.is_closed then
				continue
			end if
			appendFile(comp, outPath, "ip=" + pub + " port=" + p.port_number + NL)
		end for
	end if
	devs = r.devices_lan_ip
	if devs != null then
		for d in devs
			appendFile(comp, outPath, "ip=" + d + NL)
		end for
	end if
	return null
end function

// ---- main ----

main = function(params)
	comp = get_shell.host_computer
	globals.comp0 = comp
	gens = 0
	maxT = 3
	rndN = 2
	autoInstall = false
	maxMin = 10
	idleMax = 3
	quietEntry = false
	exfilPath = home_dir + "/Desktop/bankintel.txt"
	statePath = home_dir + "/worm.state"
	user = "worm"
	pass = "W0rmPass26x"
	rootPass = "R00tPass26x"
	scanOnly = false
	outOverride = null
	seeds = []
	if params != null then
		for p in params
			if p == "-scan" then
				scanOnly = true
			else if p == "-auto" then
				autoInstall = true
			else if p.indexOf("-max=") == 0 then
				maxMin = val(p[5:])
			else if p.indexOf("-idle=") == 0 then
				idleMax = val(p[5:])
			else if p == "-qe" then
				quietEntry = true
			else if p.indexOf("-g=") == 0 then
				gens = val(p[3:])
			else if p.indexOf("-t=") == 0 then
				maxT = val(p[3:])
			else if p.indexOf("-r=") == 0 then
				rndN = val(p[3:])
			else if p.indexOf("-o=") == 0 then
				outOverride = p[3:]
				exfilPath = p[3:]
			else if p.indexOf("-s=") == 0 then
				statePath = p[3:]
			else if p.indexOf("-u=") == 0 then
				user = p[3:]
			else if p.indexOf("-w=") == 0 then
				pass = p[3:]
			else if p.indexOf("-rp=") == 0 then
				rootPass = p[3:]
			else if p.indexOf("-") != 0 then
				seeds.push(p)
			end if
		end for
	end if
	globals.quietEntry = quietEntry
	if gens == null or gens < 0 then
		gens = 0
	end if
	if maxT == null or maxT < 1 then
		maxT = 1
	end if
	if maxT > 10 then
		print("worm: capping hosts at 10 per generation")
		maxT = 10
	end if
	if rndN == null or rndN < 0 then
		rndN = 0
	end if
	if rndN > 8 then
		rndN = 8
	end if

	if scanOnly then
		outPath = outOverride
		if outPath == null then
			outPath = home_dir + "/wscan.txt"
		end if
		scanMode(comp, outPath)
		print("worm: scan complete -> " + outPath)
		return null
	end if

	// sources carried for spreading (text only — binaries go by scp)
	exSrc = readFileOr(comp, home_dir + "/exploit.src", null)
	wormSrc = readFileOr(comp, home_dir + "/worm.src", null)
	if exSrc == null then
		print("worm: ~/exploit.src missing — no spread or escalation this run")
	end if

	ensureFolder(comp, home_dir + "/Desktop")
	state = stateLoad(comp, statePath)
	frontier = state[0]
	owned = state[1]
	done = state[2]
	selfLan = comp.local_ip
	selfPub = comp.public_ip
	selfGuard = function(ip)
		if ip == selfLan or ip == selfPub then
			return true
		end if
		return false
	end function
	for s in seeds
		if knownIp(frontier, owned, done, s) == false and selfGuard(s) == false then
			frontier.push(s)
		end if
	end for
	if frontier.len == 0 and owned.len == 0 then
		r = get_router
		if r != null then
			devs = r.devices_lan_ip
			if devs != null then
				for d in devs
					if knownIp(frontier, owned, done, d) == false and selfGuard(d) == false then
						frontier.push(d)
					end if
				end for
			end if
		end if
	end if

	if autoInstall then
		installAutorun(comp)
	end if
	rndCounter = 1
	cycle = 0
	infected = 0
	idleRun = 0
	startT = floor(time())
	if maxMin == null or maxMin < 1 then
		maxMin = 10
	end if
	if idleMax == null or idleMax < 1 then
		idleMax = 3
	end if
	wlog("worm: EPIDEMIC (bounded — max " + maxMin + " min, exits after " + idleMax + " idle cycles; state: " + statePath + ")")
	while true
		cycle = cycle + 1
		if gens > 0 and cycle > gens then
			wlog("worm: cycle cap reached")
			break
		end if
		// immortal by directive: no runtime cap, no idle shutdown —
		// -max/-idle are accepted but inert (command-line compatibility)
		// random publics only when starved — probing costs CPU too
		if frontier.len < 1 then
			for rI in range(1, rndN)
				rip = rndPublicIp(rndCounter + cycle * 31)
				rndCounter = rndCounter + 1
				if knownIp(frontier, owned, done, rip) == false and selfGuard(rip) == false then
					frontier.push(rip)
				end if
			end for
		end if
		worked = 0
		gainedThisCycle = 0
		while worked < maxT and frontier.len > 0
			ip = frontier[0]
			frontier.remove(0)
			if is_valid_ip(ip) != 1 then
				done.push(ip)
				continue
			end if
			res = processVictim(comp, ip, exfilPath, user, pass, rootPass, exSrc, wormSrc)
			infected = infected + 1
			// counts TRIES; owned.len is the real infection count
			if typeof(res) == "list" then
				newIps = res[1]
				owned.push([ip, user, pass])
				gainedThisCycle = gainedThisCycle + 1
				for nip in newIps
					if knownIp(frontier, owned, done, nip) == false and is_valid_ip(nip) == 1 and selfGuard(nip) == false then
						frontier.push(nip)
					end if
				end for
			else
				done.push(ip)
			end if
			worked = worked + 1
			// state saved after EVERY host: any death resumes cleanly
			stateSave(comp, statePath, frontier, owned, done)
		end while
		if gainedThisCycle > 0 then
			idleRun = 0
		else
			idleRun = idleRun + 1
		end if
		wlog("worm: cycle " + cycle + " — owned total " + owned.len + ", frontier " + frontier.len + ", idle streak " + idleRun + " (exfil: " + exfilPath + ")")
		// pacing: CPU wear is real — breathe between cycles
		wait(5)
	end while
	if autoInstall then
		installAutorun(comp)
	end if
	wlog("worm: run complete. exfil: " + exfilPath + " — rerun to keep spreading")
	return null
end function

main(params)
