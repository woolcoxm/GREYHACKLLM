// worm — epidemic harvesting worm (GreyLLM standard)
// WORM_VERSION = "23" (daemon auto-installs/updates this file)
//
// STANDALONE: no agent, daemon, or bridge required — needs ~/exploit.src
// beside it (and compiles it if the binary is missing). Works in
// multiplayer: paste this into the in-game Code Editor, save as
// ~/worm.src, Compile, then run ~/worm from any terminal.
//
// ARCHITECTURE (v19+): the worm is the FRONTIER DRIVER. It does not touch
// victims itself — for each host it launches ~/exploit, which runs the
// ASSAULT LADDER IN-PROCESS while its foothold objects are alive:
//   full-fire EVERY vuln (never stop at the first foothold) -> rank all
//   footholds by access (root-class > user > guest) -> kernel attack
//   when rootless -> crack /etc/passwd + become the strongest account
//   via connect_service (no su exists in this game) -> harvest
//   bank/mail/wallet/passwd -> local -L escalation with SCP'd BINARIES
//   (never build on the victim — guests cannot) -> delegate the next
//   generation to the victim's CPU -> clean artifacts + wipe the log.
// The worm reads the report (HARVEST/OWNED/NEWTARGET/WINNER/BESTPRIV),
// records state, collects WINNERS (known-good exploit pairs fire first
// on any host running the same library version), writes the Desktop
// digest, and moves to the next host. Re-entry via connect_service is
// retired: http-only hosts have no ssh:22 to return to, create_user is
// root-only, /etc/passwd is guest-denied.
//
// The infection TREE carries loot home bucket-brigade style: each child's
// -E exfil file is pulled up by its parent through the foothold object
// after the synchronous launch returns, hop by hop, until it lands in
// ~/Desktop/bankintel.txt on YOUR machine.
//
// usage (from your home machine):
//   worm [ip ...] [flags]      THE EPIDEMIC — infect -> harvest ->
//                              scan -> infect, breadth-first, FOREVER —
//                              no runtime cap, no idle shutdown (per
//                              operator directive: a worm never stops).
//                              -g=N still caps cycles when explicitly
//                              passed (the agent/harness must use it —
//                              an unbounded run blocks the serve loop).
//                              CPU-wear note: sustained load degrades
//                              hardware; 5s pacing between cycles is the
//                              only restraint left. Run on hardware you
//                              can afford to lose.
//     -g=N   cap on infection cycles this run (default 0 = INFINITE)
//     -t=N   hosts per cycle                (default 3, cap 10)
//     -r=N   random public IPs per cycle    (default 2, cap 8)
//     -depth=N   infection tree depth passed to the exploit's child
//                delegation (default 3; children pass depth-1 down)
//     -auto  ALSO install itself into /etc/init.d (autorun: the
//            epidemic resumes automatically at every game login)
//     -o=P   exfil file, appended per host    (default ~/Desktop/bankintel.txt)
//     -s=P   state file                       (default ~/worm.state)
//     -u=U -w=P   durable creds on victims    (default worm / W0rmPass26x — alphanumeric, <=15)
//     -rp=P  password tried for root changes  (default R00tPass26x)
//     -fanout=N   PARALLELISM: split the frontier across N shard state
//                 files and print the N terminal commands to run —
//                 open them all and N worms work simultaneously
//                 (GreyScript has no threads; concurrent PROCESSES are
//                 the only true parallelism — init.d runs up to 15
//                 programs at login, verified in game source)
//     -install-workers=N  fanout AND install N compiled launchers into
//                 /etc/init.d — every login auto-starts N parallel
//                 workers (CPU wear scales with N; default cap 8)
//     -merge      union all shard states back into ~/worm.state
//
// internal modes (launched BY other components, not by you):
//   worm -scan -o=PATH        print "ip=A port=N" lines for this
//                             machine's network (runs ON a victim)
//   worm -child -depth=N ...  the delegated next generation — runs ON an
//                             infected machine, all paths in /tmp
//                             (loot.txt, wstate; homeBase=/tmp)
//
// Mechanics (all verified in-game): footholds only via ~/exploit (this
// worm never fires overflow()); ping gates skip dead addresses before
// any work; every credential is validated [a-zA-Z0-9]{1,15} BEFORE any
// attack fires (the game rejects anything else); cross-machine file
// moves use text drop+build or shell.scp (get_content refuses binary
// files). GreyScript has no try/catch: every call below is
// null/typeof-guarded, loops are bounded, and state is saved after
// EVERY host so any death resumes.

NL = char(10)


isAlnum = function(s)
	// game rule: usernames/passwords/overflow password args must be
	// [a-zA-Z0-9], 1-15 chars — validated BEFORE any attack fires
	if s == null then
		return false
	end if
	if s.len < 1 or s.len > 15 then
		return false
	end if
	for i in range(0, s.len - 1)
		c = s[i]
		ok = false
		if c >= "a" and c <= "z" then
			ok = true
		else if c >= "A" and c <= "Z" then
			ok = true
		else if c >= "0" and c <= "9" then
			ok = true
		end if
		if ok == false then
			return false
		end if
	end for
	return true
end function

guardCreds = function(user, pass, rootPass)
	bad = []
	if isAlnum(user) == false then
		bad.push("username '" + user + "'")
	end if
	if isAlnum(pass) == false then
		bad.push("password '" + pass + "'")
	end if
	if rootPass != null and isAlnum(rootPass) == false then
		bad.push("root/password-change arg '" + rootPass + "'")
	end if
	if bad.len > 0 then
		print("CREDENTIAL ERROR — the game only accepts alphanumeric (a-z A-Z 0-9), 1-15 chars:")
		for b in bad
			print("  invalid " + b)
		end for
		print("Fix the -u=/-w=/-g= flags or the tool defaults. Nothing was attacked.")
		return false
	end if
	return true
end function

LOGPATH = home_dir + "/worm.log"

wlog = function(line)
	// every worm line goes to the terminal AND ~/worm.log — inspect
	// anytime with read_file even when the launching terminal is gone
	print(line)
	lf = globals.comp0.File(LOGPATH)
	if lf == null then
		globals.comp0.touch(home_dir, "worm.log")
		lf = globals.comp0.File(LOGPATH)
	end if
	if lf != null then
		base = lf.get_content
		if base == null then
			base = ""
		end if
		want = base + line + NL
		lf.set_content(want)
		// tree-flush race check: verify, retry once
		back = lf.get_content
		if back == null or back != want then
			lf.set_content(want)
		end if
	end if
	return null
end function

containsStr = function(hay, needle)
	if hay == null then
		return false
	end if
	return hay.indexOf(needle) != null
end function

ensureFolder = function(comp, path)
	f = comp.File(path)
	if f != null then
		return f
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	r = comp.create_folder(parent_path(path), name)
	f = comp.File(path)
	if f == null then
		print("cannot create folder " + path + " (" + r + ")")
	end if
	return f
end function

ensureFile = function(comp, path, initial)
	f = comp.File(path)
	if f != null then
		return f
	end if
	parts = path.split("/")
	name = parts[parts.len - 1]
	comp.touch(parent_path(path), name)
	f = comp.File(path)
	if f == null then
		return null
	end if
	if initial != null then
		f.set_content(initial)
	end if
	return f
end function

readFileOr = function(comp, path, fallback)
	f = comp.File(path)
	if f == null then
		return fallback
	end if
	c = f.get_content
	if c == null then
		return fallback
	end if
	return c
end function

appendFile = function(comp, path, text)
	f = ensureFile(comp, path, null)
	if f == null then
		print("cannot write " + path)
		return null
	end if
	base = f.get_content
	if base == null then
		base = ""
	end if
	f.set_content(base + text)
	return null
end function

rndByte = function(salt)
	// decorrelated pseudo-random byte: different arithmetic per call so
	// consecutive bytes never share offsets (rnd() alone is deterministic)
	// time() is a FLOAT and there is no integer division — every result
	// must be floored or the address bytes become decimals
	t = floor(time())
	n1 = floor((t * 7919 + salt * 104729) % 251)
	n2 = floor((floor(t / 7) + salt * 31 + 97) % 241)
	n3 = floor(((t % 65536 * salt) + 337) % 239)
	pick = salt % 3
	if pick == 0 then
		r = n1
	else if pick == 1 then
		r = n2
	else
		r = n3
	end if
	r = floor(r + salt % 17)
	r = floor(r % 254)
	if r == null or r < 1 then
		r = salt % 253 + 1
	end if
	return r
end function

rndPublicIp = function(counter)
	a = rndByte(counter)
	b = rndByte(counter * 5 + 11)
	c = rndByte(counter * 13 + 29)
	d = rndByte(counter * 29 + 71)
	// keep clear of private/reserved ranges
	if a == 10 or a == 127 or a == 172 or a == 192 or a < 20 then
		a = a % 100 + 30
	end if
	return a + "." + b + "." + c + "." + d
end function

// ---- state: "F|ip" frontier, "O|ip|user|pass" owned, "D|ip" done ----

stateLoad = function(comp, path)
	frontier = []
	owned = []
	done = []
	skipped = 0
	raw = readFileOr(comp, path, "")
	if raw == "" then
		return [frontier, owned, done]
	end if
	lines = raw.split(NL)
	for line in lines
		line = line.trim
		if line == "" then
			continue
		end if
		parts = line.split("|")
		// STRICT parse — the lenient version once accepted corrupted
		// 5-field lines ("O|O|||1") as owned hosts with ip "O"
		if line.indexOf("F|") == 0 and parts.len == 2 then
			if is_valid_ip(parts[1]) == 1 then
				frontier.push(parts[1])
			else
				skipped = skipped + 1
			end if
		else if line.indexOf("O|") == 0 and parts.len == 4 then
			if is_valid_ip(parts[1]) == 1 then
				owned.push([parts[1], parts[2], parts[3]])
			else
				skipped = skipped + 1
			end if
		else if line.indexOf("D|") == 0 and parts.len == 2 then
			if is_valid_ip(parts[1]) == 1 then
				done.push(parts[1])
			else
				skipped = skipped + 1
			end if
		else
			skipped = skipped + 1
		end if
	end for
	if skipped > 0 then
		wlog("worm: purged " + skipped + " malformed state line(s) on load")
	end if
	return [frontier, owned, done]
end function

stateSave = function(comp, path, frontier, owned, done)
	out = ""
	for ip in frontier
		out = out + "F|" + ip + NL
	end for
	for o in owned
		out = out + "O|" + o[0] + "|" + o[1] + "|" + o[2] + NL
	end for
	for ip in done
		out = out + "D|" + ip + NL
	end for
	f = ensureFile(comp, path, null)
	if f != null then
		f.set_content(out)
	end if
	return null
end function

knownIp = function(frontier, owned, done, ip)
	for x in frontier
		if x == ip then
			return true
		end if
	end for
	for o in owned
		if o[0] == ip then
			return true
		end if
	end for
	for x in done
		if x == ip then
			return true
		end if
	end for
	return false
end function

installAutorun = function(comp)
	// /etc/init.d on the PLAYER's machine is executed at every game
	// login (AutorunServerRpc, verified in game source) — installing
	// ourselves here makes the epidemic resume automatically each
	// session. Best-effort: requires /etc/init.d write access (root).
	initd = comp.File("/etc/init.d")
	if initd == null then
		print("worm: no /etc/init.d folder — autorun install skipped")
		return false
	end if
	bin = comp.File(home_dir + "/worm")
	if bin == null then
		print("worm: compile ~/worm.src first (-auto needs the binary)")
		return false
	end if
	r = bin.copy("/etc/init.d")
	if typeof(r) == "string" then
		print("worm: autorun install failed: " + r + " (need root? try after -L root)")
		return false
	end if
	print("worm: installed into /etc/init.d — epidemic auto-resumes every login")
	return true
end function

digestHost = function(comp, ip, priv, files, cracked, targets)
	// human-readable per-host line on the Desktop — with this file,
	// "gained 50 shells and did nothing" is visible within one glance
	path = home_dir + "/Desktop/wormreport.txt"
	if globals.digestPath != null then
		path = globals.digestPath
	end if
	appendFile(comp, path, ip + " — " + priv + " | files=" + files + " cracked=" + cracked + " newTargets=" + targets + NL)
	return null
end function

processVictim = function(comp, ip, exfilPath, user, pass, rootPass, exSrc, wormSrc)
	// returns ["owned", newIps], "done", or "skip"
	mark = "worm: " + ip
	shell = get_shell

	// 0. ensure our standard tool exists (self-heal compile)
	expBin = comp.File(globals.homeBase + "/exploit")
	if expBin == null then
		b = shell.build(home_dir + "/exploit.src", home_dir)
		if b != "" then
			wlog(mark + ": no ~/exploit and build failed: " + b)
			return "skip"
		end if
	end if

	// 1. break in — the exploit v19 ASSAULT LADDER: full-fire every
	// vuln, rank all footholds, kernel when rootless, crack+become,
	// harvest, scp-deploy the local -L escalation, delegate children.
	// Quiet mode (-qe) starved the worm to zero entries once — never
	// default it.
	//
	// REPORT PATH: deterministic wreport.txt beside the binary, passed
	// with -o — no findOut mirroring, no fallback divergence (the v11
	// lesson: reading a fixed path while the tool fell back discarded
	// 10 real footholds as "no entry").
	outPath = globals.homeBase + "/wreport.txt"
	outF = ensureFile(comp, outPath, " ")
	if outF != null then
		outF.set_content(" ")
	end if
	winnersPath = globals.homeBase + "/worm.wins"
	entryFlags = ""
	if globals.quietEntry == true then
		entryFlags = " -q"
	end if
	if guardCreds(user, pass, rootPass) == false then
		return "skip"
	end if
	depthArg = " -depth=" + globals.wormDepth
	lr = shell.launch(globals.homeBase + "/exploit", ip + entryFlags + " -u=" + user + " -w=" + pass + " -g=" + rootPass + " -E=" + exfilPath + " -o=" + outPath + " -winners=" + winnersPath + depthArg)
	if lr != 1 then
		wlog(mark + ": exploit launch failed: " + lr)
		return "skip"
	end if
	report = readFileOr(comp, outPath, "")
	// WINNERS: known-good exploit pairs ride the state — same library
	// version on another host fires them first (vuln sets are stable
	// per version)
	winTxt = readFileOr(comp, winnersPath, "")
	for line in report.split(NL)
		wi = line.indexOf("WINNER ")
		if wi != null then
			wl = line[wi + 7:].trim
			parts = wl.split(" ")
			if parts.len >= 4 then
				key = parts[0] + "|" + parts[1] + "|" + parts[2] + "|" + parts[3]
				if containsStr(winTxt, key) == false then
					appendFile(comp, winnersPath, key + NL)
					winTxt = winTxt + key + NL
				end if
			end if
		end if
	end for
	if containsStr(report, "FOOTHOLD") == false and containsStr(report, "SUCCESS") == false then
		wlog(mark + ": no entry (requirements unmet or nothing there)")
		digestHost(comp, ip, "no entry", 0, 0, 0)
		return "done"
	end if

	// 2. the exploit v19 ladder worked the best foothold IN-PROCESS —
	// re-login is obsolete (http-only hosts have no ssh:22 to return
	// to, create_user is root-only, /etc/passwd is guest-denied).
	// Read what the foothold already extracted.
	harvestedFiles = 0
	harvestedChars = 0
	crackedCount = 0
	bestPriv = "foothold"
	for line in report.split(NL)
		h = line.indexOf("HARVEST ")
		if h != null then
			harvestedFiles = harvestedFiles + 1
			op = line.indexOf("(")
			cp2 = line.indexOf(" chars)")
			if op != null and cp2 != null then
				harvestedChars = harvestedChars + val(line[op + 1:cp2])
			end if
		else if line.indexOf("CRACKED ") != null then
			crackedCount = crackedCount + 1
		else if line.indexOf("BESTPRIV ") != null then
			bp = line.indexOf("BESTPRIV ")
			bestPriv = line[bp + 9:].trim
		end if
	end for
	// entries for the state file: hosts we OWNED get kept with the
	// durable creds; per operator directive hosts are DONE forever —
	// no re-attacks, the frontier only grows from new discoveries.
	ownedNow = containsStr(report, "OWNED ")

	// 3-7 (v19): the exploit does harvest/crack/escalate/delegate/
	// clean AT FOOTHOLD TIME. The worm's remaining job per host: count
	// the take, write the digest, mark state, and move on. NEWTARGET
	// lines ride the report from the victim-side scan / child worms.
	newIps = []
	for line in report.split(NL)
		nt = line.indexOf("NEWTARGET ")
		if nt != null then
			nip = line[nt + 10:].trim
			if nip != "" then
				newIps.push(nip)
			end if
		end if
	end for
	digestHost(comp, ip, bestPriv, harvestedFiles, crackedCount, newIps.len)
	if harvestedFiles > 0 then
		wlog(mark + ": OWNED " + bestPriv + " — harvested " + harvestedFiles + " files (" + harvestedChars + " chars), cracked " + crackedCount + " accounts, +" + newIps.len + " targets")
	else if crackedCount > 0 then
		wlog(mark + ": OWNED " + bestPriv + " — no files, but " + crackedCount + " accounts cracked, +" + newIps.len + " targets")
	else
		wlog(mark + ": worked " + bestPriv + " — nothing readable from this access, +" + newIps.len + " targets")
	end if
	return ["owned", newIps]
end function

// ---- scan mode (runs ON a victim; the parent reads the file back) ----

scanMode = function(comp, outPath)
	r = get_router
	if r == null then
		appendFile(comp, outPath, "scan: no router" + NL)
		return null
	end if
	pub = r.public_ip
	if pub == null then
		appendFile(comp, outPath, "scan: no public ip" + NL)
		return null
	end if
	ports = r.used_ports
	if ports != null then
		for p in ports
			if p.is_closed then
				continue
			end if
			appendFile(comp, outPath, "ip=" + pub + " port=" + p.port_number + NL)
		end for
	end if
	devs = r.devices_lan_ip
	if devs != null then
		for d in devs
			appendFile(comp, outPath, "ip=" + d + NL)
		end for
	end if
	return null
end function

// ---- main ----

main = function(params)
	comp = get_shell.host_computer
	globals.comp0 = comp
	gens = 0
	maxT = 3
	rndN = 2
	autoInstall = false
	quietEntry = false
	mergeMode = false
	fanoutN = null
	installWorkers = false
	childMode = false
	childBase = null
	depth = 3
	exfilPath = home_dir + "/Desktop/bankintel.txt"
	statePath = home_dir + "/worm.state"
	user = "worm"
	pass = "W0rmPass26x"
	rootPass = "R00tPass26x"
	scanOnly = false
	outOverride = null
	seeds = []
	if params != null then
		for p in params
			if p == "-scan" then
				scanOnly = true
			else if p == "-auto" then
				autoInstall = true
			else if p == "-qe" then
				quietEntry = true
			else if p == "-merge" then
				mergeMode = true
			else if p == "-child" then
				childMode = true
			else if p.indexOf("-base=") == 0 then
				childBase = p[6:]
			else if p.indexOf("-depth=") == 0 then
				depth = val(p[7:])
			else if p.indexOf("-fanout=") == 0 then
				fanoutN = val(p[8:])
			else if p.indexOf("-install-workers=") == 0 then
				fanoutN = val(p[17:])
				installWorkers = true
			else if p.indexOf("-g=") == 0 then
				gens = val(p[3:])
			else if p.indexOf("-t=") == 0 then
				maxT = val(p[3:])
			else if p.indexOf("-r=") == 0 then
				rndN = val(p[3:])
			else if p.indexOf("-o=") == 0 then
				outOverride = p[3:]
				exfilPath = p[3:]
			else if p.indexOf("-s=") == 0 then
				statePath = p[3:]
			else if p.indexOf("-u=") == 0 then
				user = p[3:]
			else if p.indexOf("-w=") == 0 then
				pass = p[3:]
			else if p.indexOf("-rp=") == 0 then
				rootPass = p[3:]
			else if p.indexOf("-") != 0 then
				seeds.push(p)
			end if
		end for
	end if
	globals.quietEntry = quietEntry
	globals.wormDepth = depth
	if gens == null or gens < 0 then
		gens = 0
	end if
	if maxT == null or maxT < 1 then
		maxT = 1
	end if
	if maxT > 10 then
		print("worm: capping hosts at 10 per generation")
		maxT = 10
	end if
	if rndN == null or rndN < 0 then
		rndN = 0
	end if
	if rndN > 8 then
		rndN = 8
	end if

	if fanoutN != null or mergeMode then
		if mergeMode then
			// union every shard state into the main one
			allF = []
			allO = []
			allD = []
			for k in range(1, 16)
				shard = comp.File(home_dir + "/worm.state." + k)
				if shard == null then
					continue
				end if
				st = stateLoad(comp, home_dir + "/worm.state." + k)
				for x in st[0]
					allF.push(x)
				end for
				for x in st[1]
					allO.push(x)
				end for
				for x in st[2]
					allD.push(x)
				end for
				shard.delete
			end for
			stateSave(comp, statePath, allF, allO, allD)
			print("worm: merged — frontier " + allF.len + ", owned " + allO.len + ", done " + allD.len)
			return null
		end if
		if fanoutN < 1 then
			fanoutN = 1
		end if
		if fanoutN > 8 then
			print("worm: capping fanout at 8 (CPU wear scales with workers)")
			fanoutN = 8
		end if
		state = stateLoad(comp, statePath)
		shards = []
		for k in range(1, fanoutN)
			stateSave(comp, home_dir + "/worm.state." + k, [], [], [])
			shards.push(stateLoad(comp, home_dir + "/worm.state." + k))
		end for
		flist = state[0]
		for i in range(0, flist.len - 1)
			k = (i + 1) % fanoutN
			shards[k][0].push(flist[i])
		end for
		print("worm: frontier of " + flist.len + " split across " + fanoutN + " workers")
		for k in range(1, fanoutN)
			stateSave(comp, home_dir + "/worm.state." + k, shards[k - 1][0], shards[k - 1][1], shards[k - 1][2])
			print("  terminal " + k + ":  worm -s=" + home_dir + "/worm.state." + k)
		end for
		if installWorkers then
			for k in range(1, fanoutN)
				ls = "get_shell.launch(home_dir + " + char(34) + "/worm" + char(34) + ", " + char(34) + "-s=" + home_dir + "/worm.state." + k + char(34) + ")"
				src2 = "// worm worker " + k + char(10) + "main = function(params)" + char(10) + char(9) + ls + char(10) + "end function" + char(10) + "main(params)" + char(10)
				f2 = comp.File("/etc/init.d/wormworker" + k + ".src")
				if f2 == null then
					comp.touch("/etc/init.d", "wormworker" + k + ".src")
					f2 = comp.File("/etc/init.d/wormworker" + k + ".src")
				end if
				if f2 != null then
					f2.set_content(src2)
					bw = get_shell.build("/etc/init.d/wormworker" + k + ".src", "/etc/init.d")
					if bw == "" then
						print("  worker " + k + " installed in /etc/init.d (runs at every login)")
					else
						print("  worker " + k + " build failed: " + bw)
					end if
				end if
			end for
			print("worm: N parallel workers auto-start at every login (remove with: rm /etc/init.d/wormworker*)")
		end if
		return null
	end if

	if scanOnly then
		outPath = outOverride
		if outPath == null then
			outPath = home_dir + "/wscan.txt"
		end if
		scanMode(comp, outPath)
		print("worm: scan complete -> " + outPath)
		return null
	end if

	// child mode: everything lives in /tmp beside the dropped sources;
	// root mode: the player's home
	homeBase = home_dir
	if childMode then
		// -base= tells the child where the parent scp'd its tools
		// (the landing dir, which is not always /tmp — routers offer
		// /home/guest). Default /tmp for legacy launches.
		homeBase = "/tmp"
		if childBase != null then
			homeBase = childBase
		end if
		if exfilPath == home_dir + "/Desktop/bankintel.txt" then
			exfilPath = homeBase + "/loot.txt"
		end if
		if statePath == home_dir + "/worm.state" then
			statePath = homeBase + "/wstate"
		end if
	end if

	globals.homeBase = homeBase
	// digest: the root worm reports to the Desktop; children report to
	// their sandbox (pulled loot carries the substance anyway)
	if childMode then
		globals.digestPath = homeBase + "/wdigest.txt"
	else
		globals.digestPath = null
	end if

	// sources carried for spreading (text only — binaries go by scp)
	exSrc = readFileOr(comp, homeBase + "/exploit.src", null)
	wormSrc = readFileOr(comp, homeBase + "/worm.src", null)
	if exSrc == null then
		print("worm: ~/exploit.src missing — no spread or escalation this run")
	end if

	ensureFolder(comp, home_dir + "/Desktop")
	state = stateLoad(comp, statePath)
	frontier = state[0]
	owned = state[1]
	done = state[2]
	// OWN-NETWORK GUARD: the home LAN is OUR infrastructure. The v2-era
	// seeding filled the frontier from get_router.devices_lan_ip and the
	// guard only excluded the player's own two IPs — the epidemic then
	// exploited the player's OWN router (192.168.1.1) and DISABLED ITS
	// FIREWALL via the kernel attack. Never again: enumerate every
	// device on our router + both our IPs + the router's, and block the
	// whole /24 prefix of our local address.
	globals.ownNet = []
	r0 = get_router
	if r0 != null then
		devs0 = r0.devices_lan_ip
		if devs0 != null then
			for d0 in devs0
				if d0 != null then
					globals.ownNet.push(d0)
				end if
			end for
		end if
		if r0.local_ip != null then
			globals.ownNet.push(r0.local_ip)
		end if
		if r0.public_ip != null then
			globals.ownNet.push(r0.public_ip)
		end if
	end if
	if comp.local_ip != null then
		globals.ownNet.push(comp.local_ip)
	end if
	if comp.public_ip != null then
		globals.ownNet.push(comp.public_ip)
	end if
	globals.lanPrefix = null
	if comp.local_ip != null then
		// CAREFUL: split() is REGEX-based — split(".") explodes into
		// single characters (regex dot = any char), so the prefix is
		// derived by scanning for the third dot instead
		dots = []
		for ci in range(0, comp.local_ip.len - 1)
			if comp.local_ip[ci] == "." then
				dots.push(ci)
			end if
		end for
		if dots.len == 3 then
			globals.lanPrefix = comp.local_ip[:dots[2] + 1]
		end if
	end if
	selfGuard = function(ip)
		if ip == null then
			return true
		end if
		for x in globals.ownNet
			if x == ip then
				return true
			end if
		end for
		if globals.lanPrefix != null and ip.indexOf(globals.lanPrefix) == 0 then
			return true
		end if
		return false
	end function
	for s in seeds
		if knownIp(frontier, owned, done, s) == false and selfGuard(s) == false then
			frontier.push(s)
		else if selfGuard(s) then
			wlog("worm: seed " + s + " is on YOUR network — refusing to attack it")
		end if
	end for
	// NO LAN AUTO-SEED: seeding from devices_lan_ip attacked our own
	// router once. Fresh seedless runs go straight to random publics.

	if autoInstall then
		installAutorun(comp)
	end if
	rndCounter = 1
	cycle = 0
	infected = 0
	idleRun = 0
	wlog("worm: EPIDEMIC (immortal — no runtime cap, no idle shutdown; pass -g=N to bound cycles; state: " + statePath + ")")
	while true
		cycle = cycle + 1
		if gens > 0 and cycle > gens then
			wlog("worm: cycle cap reached")
			break
		end if
		// random publics only when starved — probing costs CPU too
		if frontier.len < 1 then
			for rI in range(1, rndN)
				rip = rndPublicIp(rndCounter + cycle * 31)
				rndCounter = rndCounter + 1
				if knownIp(frontier, owned, done, rip) == false and selfGuard(rip) == false then
					frontier.push(rip)
				end if
			end for
		end if
		worked = 0
		gainedThisCycle = 0
		while worked < maxT and frontier.len > 0
			ip = frontier[0]
			frontier.remove(0)
			if is_valid_ip(ip) != 1 then
				done.push(ip)
				continue
			end if
			// belt and braces: state files from older runs may still
			// hold home-LAN entries — never attack them, retire them
			if selfGuard(ip) then
				wlog("worm: " + ip + " is on YOUR network — retired, never attacked")
				done.push(ip)
				continue
			end if
			res = processVictim(comp, ip, exfilPath, user, pass, rootPass, exSrc, wormSrc)
			infected = infected + 1
			// counts TRIES; owned.len is the real infection count
			if typeof(res) == "list" then
				newIps = res[1]
				owned.push([ip, user, pass])
				gainedThisCycle = gainedThisCycle + 1
				for nip in newIps
					if knownIp(frontier, owned, done, nip) == false and is_valid_ip(nip) == 1 and selfGuard(nip) == false then
						frontier.push(nip)
					end if
				end for
			else
				done.push(ip)
			end if
			worked = worked + 1
			// state saved after EVERY host: any death resumes cleanly
			stateSave(comp, statePath, frontier, owned, done)
		end while
		if gainedThisCycle > 0 then
			idleRun = 0
		else
			idleRun = idleRun + 1
		end if
		wlog("worm: cycle " + cycle + " — owned total " + owned.len + ", frontier " + frontier.len + ", idle streak " + idleRun + " (exfil: " + exfilPath + ")")
		// pacing: CPU wear is real — breathe between cycles
		wait(5)
	end while
	if autoInstall then
		installAutorun(comp)
	end if
	wlog("worm: run complete. exfil: " + exfilPath + " — rerun to keep spreading")
	return null
end function

main(params)
