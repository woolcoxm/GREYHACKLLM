// canonical LAN port scanner — API under test
scanLan = function()
    router = get_router
    if router == null then
        print("no router")
        return
    end if
    devices = router.devices_lan_ip
    lines = []
    for ip in devices
        ports = router.device_ports(ip)
        if ports == null then continue
        openPorts = []
        for port in ports
            if port.is_closed then continue
            openPorts.push(port)
        end for
        if openPorts.len == 0 then
            lines.push(ip + " has no open ports")
        else
            lines.push(ip + " open ports:")
            for port in openPorts
                info = router.port_info(port)
                lines.push("  " + port.port_number + " " + info)
            end for
        end if
    end for
    print(lines.join(char(10)))
end function

scanLan()
